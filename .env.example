# Public URL users will use to reach ILIAS.
# Change this before first startup.
ILIAS_HTTP_PATH=http://ilias.example.com
ILIAS_HTTP_PORT=80

ILIAS_CLIENT_ID=myilias
ILIAS_SERVER_TIMEZONE=Europe/Berlin

ILIAS_CONTACT_FIRSTNAME=ILIAS
ILIAS_CONTACT_LASTNAME=Admin
ILIAS_CONTACT_EMAIL=admin@example.com

ILIAS_DB_NAME=ilias
ILIAS_DB_USER=ilias
ILIAS_DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_PASSWORD

# Tune this to the VM RAM. 2G is a sensible starting value for an 8 GB VM.
MARIADB_INNODB_BUFFER_POOL_SIZE=2G
